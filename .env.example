# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados (MySQL)
# A porta 3307 evita conflito com um MySQL instalado localmente na 3306.
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=reportaai
DB_PASSWORD=reportaai
DB_DATABASE=reportaai_cm
DB_LOGGING=false

# Usado apenas pelo docker-compose para criar o container
DB_ROOT_PASSWORD=root

# SuperTokens (autenticação)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# Mínimo de 20 caracteres (letras, números, "=" e "-"). O docker-compose usa o mesmo valor no Core.
SUPERTOKENS_API_KEY=reportaai-dev-supertokens-api-key
# Domínio da API e do painel web, usados pelo SuperTokens (cookies) e pelo CORS
API_DOMAIN=http://localhost:3000
WEB_APP_URL=http://localhost:5173

# Usado apenas pelo docker-compose para criar o PostgreSQL do SuperTokens
SUPERTOKENS_DB_PASSWORD=supertokens

# SuperAdm criado pelo seed (npm run seed). Não são lidas pela API.
# A senha segue a política da RN08: de 8 a 128 caracteres, com pelo menos uma letra e um número.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@reportaai.local
SUPER_ADMIN_PASSWORD=SuperAdmin123
