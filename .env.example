# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados (MySQL)
# A porta 3307 evita conflito com um MySQL instalado localmente na 3306.
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=reportaai
DB_PASSWORD=reportaai
DB_DATABASE=reportaai_cm
DB_LOGGING=false

# Usado apenas pelo docker-compose para criar o container
DB_ROOT_PASSWORD=root
