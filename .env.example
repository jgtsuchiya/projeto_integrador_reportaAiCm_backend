# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados (MySQL)
# A porta 3307 evita conflito com um MySQL instalado localmente na 3306.
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=reportaai
DB_PASSWORD=reportaai
DB_DATABASE=reportaai_cm
DB_LOGGING=false

# Usado apenas pelo docker-compose para criar o container
DB_ROOT_PASSWORD=root

# SuperTokens (autenticação)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# Mínimo de 20 caracteres (letras, números, "=" e "-"). O docker-compose usa o mesmo valor no Core.
SUPERTOKENS_API_KEY=reportaai-dev-supertokens-api-key
# Domínio da API e do painel web, usados pelo SuperTokens (cookies) e pelo CORS
API_DOMAIN=http://localhost:3000
WEB_APP_URL=http://localhost:5173
# Validade, em horas, do link de convite do ADM (enviado para ${WEB_APP_URL}/convite?token=...)
INVITATION_EXPIRES_IN_HOURS=48
# Validade, em minutos, do link de redefinição de senha (${WEB_APP_URL}/redefinir-senha?token=...)
PASSWORD_RESET_EXPIRES_IN_MINUTES=60

# Bloqueio temporário do login: com LOGIN_MAX_FAILED_ATTEMPTS falhas para o mesmo e-mail em
# LOGIN_LOCK_WINDOW_MINUTES minutos, o login dele fica bloqueado até uma das falhas sair da janela
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_WINDOW_MINUTES=15

# Limite por IP nas rotas públicas (login, cadastro do Client, aceite do convite e redefinição de senha):
# RATE_LIMIT_MAX_REQUESTS requisições a cada RATE_LIMIT_WINDOW_SECONDS segundos, em cada rota
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Quantidade de proxies reversos na frente da API (0 em dev). Define de onde o IP do cliente é lido.
# Com um valor menor que o real, todos os clientes chegam com o IP do proxy. Com um maior, o
# cliente consegue forjar o próprio IP pelo header X-Forwarded-For.
TRUST_PROXY=0

# Usado apenas pelo docker-compose para criar o PostgreSQL do SuperTokens
SUPERTOKENS_DB_PASSWORD=supertokens

# E-mail (SMTP). Em dev, o Mailpit do docker-compose captura os e-mails, que aparecem em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# true para TLS direto (porta 465). Com false, o STARTTLS é usado se o servidor oferecer.
SMTP_SECURE=false
# Vazios no Mailpit, que não exige autenticação
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ReportaAi Cm <no-reply@reportaai.local>

# SuperAdm criado pelo seed (npm run seed). Não são lidas pela API.
# A senha segue a política da RN08: de 8 a 128 caracteres, com pelo menos uma letra e um número.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@reportaai.local
SUPER_ADMIN_PASSWORD=SuperAdmin123
