# Coleção de requisições da API do ReportaAi Cm: usuários, autenticação e reportes (sprints 2 a 4).
#
# Como usar
#   1. Instale a extensão "REST Client" do VS Code (humao.rest-client, já recomendada em
#      .vscode/extensions.json) e clique em "Send Request" acima de cada requisição.
#   2. Suba o ambiente antes: npm run db:up, npm run migration:run, npm run seed e
#      npm run start:dev (ver o README).
#   3. Siga a ordem do arquivo: cada seção usa o que as anteriores criaram. Os ids e os tokens
#      de sessão são lidos das respostas (as requisições com "# @name").
#
# O login é feito no modo header (st-auth-mode: header), como o app mobile: os tokens voltam
# nos headers da resposta e o access token vai no Authorization das chamadas seguintes.
# O painel web usa cookies, que o SDK dele controla (ver docs/AUTH.md e docs/FRONTEND.md).
#
# Os passos manuais são os segredos que só existem nos e-mails: o token do convite do ADM
# (seção 3), o da verificação de e-mail (seção 5), o da redefinição de senha (seção 6), o código
# da segunda etapa do login (seção 10) e a verificação de e-mail do Client dos reportes (seção 13).

@baseUrl = http://localhost:3000/api

# SuperAdm criado pelo npm run seed (variáveis SUPER_ADMIN_* do .env).
@superAdminEmail = superadmin@reportaai.local
@superAdminPassword = SuperAdmin123

# ADM convidado na seção 3.
@adminEmail = ana.souza@reportaai.local
@adminPassword = SenhaDoAdm123

# Client cadastrado na seção 4. O CPF precisa ter os dígitos verificadores válidos.
@clientEmail = maria.silva@reportaai.local
@clientCpf = 529.982.247-25
@clientPassword = SenhaForte123
@clientNewPassword = OutraSenha456

# Token do link de convite (.../convite?token=<token>), copiado do e-mail (seção 3).
@invitationToken = cole-aqui-o-token-do-convite

# Token do link de verificação de e-mail (.../verificar-email?token=<token>), copiado do e-mail
# (seção 5).
@emailVerificationToken = cole-aqui-o-token-da-verificacao

# Token do link de redefinição de senha (.../redefinir-senha?token=<token>), copiado do e-mail
# (seção 6).
@passwordResetToken = cole-aqui-o-token-da-redefinicao

# Código de 6 dígitos da segunda etapa do login, copiado do e-mail (seção 10).
@mfaCode = 000000

# Client dos reportes (seção 13). Ele é outro, porque a seção 8 exclui o Client da seção 4.
@reporterEmail = joao.reportes@reportaai.local
@reporterCpf = 111.444.777-35
@reporterPassword = SenhaForte123

# Token do link de verificação de e-mail do Client dos reportes, copiado do e-mail (seção 13).
@reporterVerificationToken = cole-aqui-o-token-da-verificacao-do-client-dos-reportes

# Idempotency-Key do reporte da seção 13: troque por outro UUID para abrir outro reporte.
@reportIdempotencyKey = 3b241101-e2bb-4255-8caf-4136c566a962

# Imagem JPEG pequena (48 x 36 px) em base64, usada como foto e como miniatura (seção 13).
# É a test/fixtures/report-thumbnail.jpg.
@jpegBase64 = 

###
# ==============================================================================================
# 1. Saúde (público)
# ==============================================================================================

### Verifica se a API está no ar
# Resposta: 200, com { "status": "ok", "timestamp": "..." }.
GET {{baseUrl}}/health

###
# ==============================================================================================
# 2. Login do SuperAdm (rota nativa do SuperTokens, pública)
# ==============================================================================================

### Login
# Resposta: 200, com { "status": "OK", "user": {...} } e os tokens nos headers st-access-token e
# st-refresh-token. Senha errada, e-mail sem conta e usuário bloqueado também respondem 200,
# com { "status": "WRONG_CREDENTIALS_ERROR" }. Depois de 5 falhas para o mesmo e-mail em 15
# minutos, a resposta passa a ser { "status": "GENERAL_ERROR", "message": "Muitas tentativas..." },
# até uma das falhas sair da janela.
# @name loginSuperAdmin
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{superAdminEmail}}" },
    { "id": "password", "value": "{{superAdminPassword}}" }
  ]
}

###

@superAdminToken = {{loginSuperAdmin.response.headers.st-access-token}}

###
# ==============================================================================================
# 3. Convite de ADM (SUPER_ADMIN convida, o ADM aceita sem sessão)
# ==============================================================================================

### Convida o ADM: cria o usuário PENDING e envia o e-mail com o link
# Resposta: 201, com o ADM e "invitation": { "sent": true, "expiresAt": "..." }.
# E-mail já cadastrado: 409.
# @name inviteAdmin
POST {{baseUrl}}/admins
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

{
  "name": "Ana Souza",
  "email": "{{adminEmail}}"
}

###

@adminId = {{inviteAdmin.response.body.$.id}}

### (Opcional) Reenvia o convite: os links anteriores deixam de valer
# Resposta: 200, com { "sent": true, "expiresAt": "..." }. ADM que não está PENDING: 422.
POST {{baseUrl}}/admins/{{adminId}}/invitation
Authorization: Bearer {{superAdminToken}}

### Lê o último e-mail capturado pelo Mailpit (não é rota da API)
# Copie o token do link (.../convite?token=<token>) para a variável @invitationToken, no topo
# do arquivo. A caixa de entrada também abre no navegador: http://localhost:8025
GET http://localhost:8025/view/latest.txt

### Aceita o convite: define a senha e ativa o ADM (público)
# Resposta: 204. Token inválido, expirado, já usado ou substituído por um reenvio: 422.
POST {{baseUrl}}/invitations/accept
Content-Type: application/json

{
  "token": "{{invitationToken}}",
  "password": "{{adminPassword}}"
}

### Login do ADM
# Resposta: 200, com { "status": "OK", ... }. Antes do aceite, o ADM PENDING recebe
# { "status": "WRONG_CREDENTIALS_ERROR" }.
# @name loginAdmin
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{adminEmail}}" },
    { "id": "password", "value": "{{adminPassword}}" }
  ]
}

###

@adminToken = {{loginAdmin.response.headers.st-access-token}}

###
# ==============================================================================================
# 4. Autocadastro do Client (público)
# ==============================================================================================

### Cadastra o Client: CPF e telefone aceitam máscara e são salvos só com dígitos
# O Client nasce com o e-mail não verificado e recebe o link de verificação (seção 5).
# Resposta: 201, com o perfil (sem a senha). Dados inválidos: 400, com a lista de campos.
# E-mail ou CPF já cadastrado: 409.
# @name registerClient
POST {{baseUrl}}/clients
Content-Type: application/json

{
  "name": "Maria da Silva",
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}",
  "cpf": "{{clientCpf}}",
  "phone": "(44) 99999-8888",
  "birthDate": "1990-05-20"
}

###

@clientId = {{registerClient.response.body.$.id}}

###
# ==============================================================================================
# 5. Verificação de e-mail do Client
# ==============================================================================================

### Login do Client recém-cadastrado: o login não depende da verificação
# Resposta: 200, com { "status": "OK", ... }.
# @name loginUnverifiedClient
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{clientEmail}}" },
    { "id": "password", "value": "{{clientPassword}}" }
  ]
}

###

@unverifiedClientToken = {{loginUnverifiedClient.response.headers.st-access-token}}

### Reenvia o link de verificação (opcional: o cadastro já enviou um)
# O link novo invalida os anteriores. A mesma conta recebe no máximo um e-mail por minuto,
# contando o do cadastro: espere 1 minuto depois da seção 4.
# Resposta: 204. Antes de 1 minuto, ou com o e-mail já verificado: 422.
POST {{baseUrl}}/users/me/email-verification
Authorization: Bearer {{unverifiedClientToken}}

### Lê o último e-mail capturado pelo Mailpit (não é rota da API)
# Copie o token do link (.../verificar-email?token=<token>) para a variável
# @emailVerificationToken, no topo do arquivo.
GET http://localhost:8025/view/latest.txt

### Confirma o e-mail com o token do link (público)
# Depois disso, o emailVerifiedAt do GET /users/me vem preenchido.
# Resposta: 204. Token inválido, expirado, já usado ou substituído por um reenvio: 422.
POST {{baseUrl}}/email-verifications/confirm
Content-Type: application/json

{
  "token": "{{emailVerificationToken}}"
}

###
# ==============================================================================================
# 6. Recuperação de senha (público, igual para os três papéis)
# ==============================================================================================

### Pede o link de redefinição: "esqueci minha senha"
# Resposta: sempre 204, exista ou não a conta, e antes de o e-mail ser enviado. Só a conta ACTIVE
# recebe o link, que vale 60 minutos e invalida os anteriores. A mesma conta recebe no máximo
# um e-mail por minuto: um pedido repetido antes disso responde 204 e não envia nada.
# E-mail fora do formato: 400.
POST {{baseUrl}}/password-resets
Content-Type: application/json

{
  "email": "{{clientEmail}}"
}

### Lê o último e-mail capturado pelo Mailpit (não é rota da API)
# Copie o token do link (.../redefinir-senha?token=<token>) para a variável @passwordResetToken,
# no topo do arquivo.
GET http://localhost:8025/view/latest.txt

### Redefine a senha com o token do link
# Encerra todas as sessões do usuário, libera o login bloqueado por tentativas e envia o e-mail
# de aviso "Sua senha foi alterada". A coleção repete a senha do cadastro, para as seções
# seguintes continuarem funcionando.
# Resposta: 204. Token inválido, expirado, já usado ou substituído por um pedido novo: 422.
# Senha fora da política: 400, e o link continua valendo.
POST {{baseUrl}}/password-resets/confirm
Content-Type: application/json

{
  "token": "{{passwordResetToken}}",
  "password": "{{clientPassword}}"
}

###
# ==============================================================================================
# 7. Gestão de Clients pelo painel (ADMIN e SUPER_ADMIN)
# ==============================================================================================

### Lista os Clients: paginação, filtro por status e busca
# search procura um trecho do nome ou do e-mail, ou o CPF completo (com ou sem máscara).
# Resposta: 200, com { "items": [...], "page": 1, "pageSize": 20, "total": 1 }. O CPF sai
# mascarado (***.982.247-**). Com o token de um Client: 403.
GET {{baseUrl}}/clients?page=1&pageSize=20&status=ACTIVE&search=maria
Authorization: Bearer {{adminToken}}

### Consulta um Client
# Resposta: 200. Id que não é de Client (ou de Client excluído): 404.
GET {{baseUrl}}/clients/{{clientId}}
Authorization: Bearer {{adminToken}}

### Inativa o Client: ele perde o acesso na hora e as sessões dele são revogadas
# Resposta: 200, com "status": "INACTIVE". Client que já está INACTIVE: 422.
PATCH {{baseUrl}}/clients/{{clientId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "INACTIVE"
}

### Reativa o Client
# Resposta: 200, com "status": "ACTIVE".
PATCH {{baseUrl}}/clients/{{clientId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "ACTIVE"
}

###
# ==============================================================================================
# 8. Perfil e sessões do usuário logado (qualquer papel; aqui, o Client)
# ==============================================================================================

### Login do Client
# Resposta: 200, com { "status": "OK", ... }.
# @name loginClient
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{clientEmail}}" },
    { "id": "password", "value": "{{clientPassword}}" }
  ]
}

###

@clientToken = {{loginClient.response.headers.st-access-token}}

### Perfil e papel de quem está logado
# Resposta: 200. O Client recebe também cpf (completo), phone e birthDate. O mfaEnabled diz se o
# login pede o código da verificação em duas etapas (seção 10).
GET {{baseUrl}}/users/me
Authorization: Bearer {{clientToken}}

### Edita o próprio perfil: nome (todos), telefone e data de nascimento (só o Client)
# Os campos são opcionais, mas pelo menos um é obrigatório. E-mail e CPF não mudam.
# Resposta: 200, com o perfil atualizado. ADM ou SuperAdm que envia phone ou birthDate: 422.
PATCH {{baseUrl}}/users/me
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "name": "Maria da Silva Santos",
  "phone": "(44) 3523-1234",
  "birthDate": "1990-05-21"
}

### Abre uma segunda sessão do Client, como se fosse outro aparelho
# O IP e o user agent do login ficam guardados na sessão e aparecem na listagem abaixo.
# Resposta: 200, com { "status": "OK", ... }.
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header
User-Agent: ReportaAiApp/1.0 (Android 16)

{
  "formFields": [
    { "id": "email", "value": "{{clientEmail}}" },
    { "id": "password", "value": "{{clientPassword}}" }
  ]
}

### Lista as sessões abertas do usuário logado, da mais recente para a mais antiga
# Resposta: 200, com uma lista de { "id", "createdAt", "expiresAt", "ipAddress", "userAgent",
# "current" }. Só a sessão desta requisição vem com "current": true.
# @name listSessions
GET {{baseUrl}}/users/me/sessions
Authorization: Bearer {{clientToken}}

###

# A primeira da lista é a mais recente: a sessão do outro aparelho, aberta acima.
@otherSessionId = {{listSessions.response.body.$[0].id}}

### Encerra uma sessão do próprio usuário: aqui, a do outro aparelho
# A sessão encerrada não renova mais o token. O access token dela ainda vale até expirar (15 min).
# Resposta: 204. Id de uma sessão de outro usuário, já encerrada ou que não existe: 404.
DELETE {{baseUrl}}/users/me/sessions/{{otherSessionId}}
Authorization: Bearer {{clientToken}}

### Encerra todas as outras sessões e mantém a atual
# Resposta: 204, mesmo quando só existe a sessão atual.
DELETE {{baseUrl}}/users/me/sessions
Authorization: Bearer {{clientToken}}

### Troca a própria senha: encerra as outras sessões e mantém a atual
# O usuário recebe o e-mail de aviso "Sua senha foi alterada".
# Resposta: 204. Senha atual incorreta: 401.
PATCH {{baseUrl}}/users/me/password
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "currentPassword": "{{clientPassword}}",
  "newPassword": "{{clientNewPassword}}"
}

### Exclui a própria conta (só o Client), confirmando com a senha
# Os dados são anonimizados, e o e-mail e o CPF ficam livres para um novo cadastro.
# Resposta: 204. Senha incorreta: 401. ADM ou SuperAdm: 403.
DELETE {{baseUrl}}/users/me
Content-Type: application/json
Authorization: Bearer {{clientToken}}

{
  "password": "{{clientNewPassword}}"
}

###
# ==============================================================================================
# 9. Gestão de ADMs (só o SUPER_ADMIN)
# ==============================================================================================

### Lista os ADMs: paginação e filtro por status (PENDING, ACTIVE ou INACTIVE)
# Resposta: 200, com { "items": [...], "page": 1, "pageSize": 20, "total": 1 }.
# Com o token de um ADM ou de um Client: 403.
GET {{baseUrl}}/admins?page=1&pageSize=20&status=ACTIVE
Authorization: Bearer {{superAdminToken}}

### Consulta um ADM
# Resposta: 200. Id que não é de ADM (SuperAdm, Client ou ADM excluído): 404.
GET {{baseUrl}}/admins/{{adminId}}
Authorization: Bearer {{superAdminToken}}

### Edita o nome do ADM
# Resposta: 200, com o ADM atualizado.
PATCH {{baseUrl}}/admins/{{adminId}}
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

{
  "name": "Ana Souza Lima"
}

### Inativa o ADM: ele perde o acesso na hora e as sessões dele são revogadas
# Resposta: 200, com "status": "INACTIVE". ADM PENDING: 422 (o convite é cancelado pela exclusão).
PATCH {{baseUrl}}/admins/{{adminId}}/status
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

{
  "status": "INACTIVE"
}

### Reativa o ADM
# Resposta: 200, com "status": "ACTIVE".
PATCH {{baseUrl}}/admins/{{adminId}}/status
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

{
  "status": "ACTIVE"
}

### Exclui o ADM: exclusão lógica, que também cancela um convite pendente
# O e-mail fica livre para um novo convite.
# Resposta: 204.
DELETE {{baseUrl}}/admins/{{adminId}}
Authorization: Bearer {{superAdminToken}}

###
# ==============================================================================================
# 10. Verificação em duas etapas (qualquer papel; aqui, o SuperAdm, que tem o e-mail verificado)
# ==============================================================================================

### Ativa a verificação em duas etapas, confirmando com a senha atual
# Encerra as outras sessões do SuperAdm. A sessão desta requisição continua completa, sem pedir
# o código. A partir daqui, o login do SuperAdm pede o código enviado por e-mail.
# Resposta: 200, com o perfil e "mfaEnabled": true. Senha incorreta: 401. E-mail não verificado
# (o Client que ainda não confirmou o e-mail): 422. Já ativa: 200, sem efeito.
PATCH {{baseUrl}}/users/me/mfa
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

{
  "enabled": true,
  "password": "{{superAdminPassword}}"
}

### Login com a verificação em duas etapas ativa: a sessão nasce pendente
# O código de 6 dígitos vai para o e-mail do usuário.
# Resposta: 200, com { "status": "OK", ... } e os tokens da sessão pendente nos headers.
# @name loginPending
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{superAdminEmail}}" },
    { "id": "password", "value": "{{superAdminPassword}}" }
  ]
}

###

@pendingToken = {{loginPending.response.headers.st-access-token}}

### A sessão pendente só acessa as rotas de /mfa, o refresh e o signout
# Resposta: 403, com { "message": "invalid claim", "claimValidationErrors": [{ "id":
# "mfa-verified", ... }] }.
GET {{baseUrl}}/users/me
Authorization: Bearer {{pendingToken}}

### Lê o último e-mail capturado pelo Mailpit (não é rota da API)
# Copie o código de 6 dígitos para a variável @mfaCode, no topo do arquivo.
GET http://localhost:8025/view/latest.txt

### (Opcional) Reenvia o código: o anterior deixa de valer
# Resposta: 204. Menos de 1 minuto depois do último código: 422. Sessão que não está pendente: 422.
POST {{baseUrl}}/mfa/code
Authorization: Bearer {{pendingToken}}

### Confere o código e conclui o login
# Resposta: 204, com o access token atualizado no header st-access-token. Código errado, vencido
# (10 min) ou já usado: 422. No 5º erro, o código deixa de valer. Código fora do formato: 400.
# @name verifyMfa
POST {{baseUrl}}/mfa/verify
Content-Type: application/json
Authorization: Bearer {{pendingToken}}

{
  "code": "{{mfaCode}}"
}

###

@verifiedToken = {{verifyMfa.response.headers.st-access-token}}

### Com o access token atualizado, a sessão está completa
# Resposta: 200. O token antigo (@pendingToken) continua respondendo 403 até expirar.
GET {{baseUrl}}/users/me
Authorization: Bearer {{verifiedToken}}

### Desativa a verificação em duas etapas: os próximos logins não pedem mais o código
# A coleção desativa aqui, para o login das outras seções voltar ao normal. Nenhuma sessão é
# encerrada.
# Resposta: 200, com "mfaEnabled": false. Senha incorreta: 401. Já desativada: 200, sem efeito.
PATCH {{baseUrl}}/users/me/mfa
Content-Type: application/json
Authorization: Bearer {{verifiedToken}}

{
  "enabled": false,
  "password": "{{superAdminPassword}}"
}

###
# ==============================================================================================
# 11. Renovar e encerrar a sessão (rotas nativas do SuperTokens)
# ==============================================================================================

### Renova a sessão: o refresh token vai no lugar do access token
# Os SDKs de front fazem esta chamada sozinhos quando o access token expira (15 min).
# Resposta: 200, com um novo par de tokens nos headers. O refresh token é rotativo: reusar um
# token antigo depois que o novo já foi usado encerra a sessão (401).
# @name refreshSuperAdmin
POST {{baseUrl}}/auth/session/refresh
st-auth-mode: header
Authorization: Bearer {{loginSuperAdmin.response.headers.st-refresh-token}}

### Encerra a sessão atual
# Resposta: 200, com { "status": "OK" }. Para continuar usando a coleção, faça o login de novo.
POST {{baseUrl}}/auth/signout
Authorization: Bearer {{refreshSuperAdmin.response.headers.st-access-token}}

###
# ==============================================================================================
# 12. Rotas nativas desativadas (RN16)
# ==============================================================================================

### Sign-up nativo: desativado, o cadastro é pelo POST /clients
# Resposta: 404.
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "formFields": [
    { "id": "email", "value": "{{clientEmail}}" },
    { "id": "password", "value": "{{clientPassword}}" }
  ]
}

### Verificação de e-mail existente: desativada, para não revelar quais e-mails têm conta
# Resposta: 404.
GET {{baseUrl}}/auth/emailpassword/email/exists?email={{clientEmail}}

### Reset de senha nativo: desativado, a recuperação é pelo POST /password-resets (seção 6)
# Resposta: 404.
POST {{baseUrl}}/auth/user/password/reset/token
Content-Type: application/json

{
  "formFields": [{ "id": "email", "value": "{{clientEmail}}" }]
}

###
# ==============================================================================================
# 13. Reportes (só o Client, com o e-mail confirmado)
# ==============================================================================================
# Um Client novo, para os reportes não dependerem das seções anteriores. ADM e SuperAdm recebem
# 403 em todas as rotas de /reports.

### Cadastra o Client dos reportes
# @name registerReporter
POST {{baseUrl}}/clients
Content-Type: application/json

{
  "name": "João Pereira",
  "email": "{{reporterEmail}}",
  "password": "{{reporterPassword}}",
  "cpf": "{{reporterCpf}}",
  "phone": "(44) 98888-7777",
  "birthDate": "1988-03-15"
}

### Login do Client dos reportes
# @name loginReporter
POST {{baseUrl}}/auth/signin
Content-Type: application/json
st-auth-mode: header

{
  "formFields": [
    { "id": "email", "value": "{{reporterEmail}}" },
    { "id": "password", "value": "{{reporterPassword}}" }
  ]
}

###

@reporterToken = {{loginReporter.response.headers.st-access-token}}

### Abrir um reporte antes de confirmar o e-mail
# Resposta: 422, com "Confirme o seu e-mail para abrir reportes." (RN26).
POST {{baseUrl}}/reports
Content-Type: application/json
Authorization: Bearer {{reporterToken}}

{
  "location": { "latitude": -24.045812, "longitude": -52.378901, "accuracyMeters": 8.5 },
  "photo": { "content": "{{jpegBase64}}", "thumbnail": "{{jpegBase64}}" }
}

### Lê o último e-mail capturado pelo Mailpit (não é rota da API)
# Copie o token do link (.../verificar-email?token=<token>) para a variável
# @reporterVerificationToken, no topo do arquivo.
GET http://localhost:8025/view/latest.txt

### Confirma o e-mail do Client dos reportes (público)
# A mesma sessão passa a abrir reportes: o guard lê o e-mail verificado a cada requisição.
# Resposta: 204.
POST {{baseUrl}}/email-verifications/confirm
Content-Type: application/json

{
  "token": "{{reporterVerificationToken}}"
}

### Reportes já abertos perto do lugar (raio de 30 m): o app pergunta se é o mesmo buraco
# Resposta: 200, com { "items": [...] }: os reportes PENDING e CONFIRMED de qualquer Client, do
# mais perto ao mais longe, até 50, cada um com o distanceMeters. O raio vai de 10 a 5000 m
# (padrão 1000). Latitude fora da faixa ou raio acima de 5000: 400.
GET {{baseUrl}}/reports/nearby?latitude=-24.045812&longitude=-52.378901&radiusMeters=30
Authorization: Bearer {{reporterToken}}

### Abre o reporte, com a foto em base64 e a Idempotency-Key
# A foto e a miniatura são JPEG em base64 (RFC 4648, com o "=" do fim, sem "data:"): a foto até
# 2 MB e 2048 px no maior lado, a miniatura até 100 KB e 480 px. A localização precisa estar em
# Campo Mourão, com precisão de até 50 m.
# Resposta: 201, com o reporte PENDING, o canEdit e o canDelete. Campo inválido (ex.: imagem que
# não é JPEG): 400, com o campo em details. Fora da área, precisão ruim ou 11º reporte do dia:
# 422. Corpo acima de 2,8 MB: 413.
# @name openReport
POST {{baseUrl}}/reports
Content-Type: application/json
Authorization: Bearer {{reporterToken}}
Idempotency-Key: {{reportIdempotencyKey}}

{
  "description": "Buraco grande na faixa da direita, perto do semáforo.",
  "location": { "latitude": -24.045812, "longitude": -52.378901, "accuracyMeters": 8.5 },
  "photo": { "content": "{{jpegBase64}}", "thumbnail": "{{jpegBase64}}" }
}

###

@reportId = {{openReport.response.body.$.id}}

### Repete o envio com a mesma Idempotency-Key: devolve o mesmo reporte, sem criar outro
# É o que o app faz quando a resposta se perde. Resposta: 201, com o mesmo id (RN31). Se o
# reporte da chave foi excluído: 404.
POST {{baseUrl}}/reports
Content-Type: application/json
Authorization: Bearer {{reporterToken}}
Idempotency-Key: {{reportIdempotencyKey}}

{
  "description": "Buraco grande na faixa da direita, perto do semáforo.",
  "location": { "latitude": -24.045812, "longitude": -52.378901, "accuracyMeters": 8.5 },
  "photo": { "content": "{{jpegBase64}}", "thumbnail": "{{jpegBase64}}" }
}

### Lista os próprios reportes: paginação e filtro por status (PENDING, CONFIRMED ou REJECTED)
# Resposta: 200, com { items, page, pageSize, total }, do mais novo ao mais antigo.
GET {{baseUrl}}/reports/mine?page=1&pageSize=20&status=PENDING
Authorization: Bearer {{reporterToken}}

### Consulta o reporte
# Os outros Clients veem o reporte só em PENDING ou CONFIRMED, sem nenhum dado do autor.
# Resposta: 200. Reporte excluído ou que o Client não pode ver: 404.
GET {{baseUrl}}/reports/{{reportId}}
Authorization: Bearer {{reporterToken}}

### Busca a miniatura em base64
# Resposta: 200, com { "id": "<id da foto>", "mimeType": "image/jpeg", "content": "<base64>" }.
# Sem o size (ou com size=full), a foto inteira.
GET {{baseUrl}}/reports/{{reportId}}/photo?size=thumbnail
Authorization: Bearer {{reporterToken}}

### Edita a descrição: só o autor, com o reporte em validação e sem votos
# Resposta: 200, com o reporte. Com votos: 422. Fora de validação: 422. Reporte de outro Client
# que ele vê: 403.
PATCH {{baseUrl}}/reports/{{reportId}}
Content-Type: application/json
Authorization: Bearer {{reporterToken}}

{
  "description": "Buraco no meio da faixa."
}

### Troca a foto: a nova ganha outro id (o app troca o cache)
# Resposta: 200, com o photo.id novo. As regras da foto são as da abertura.
PATCH {{baseUrl}}/reports/{{reportId}}
Content-Type: application/json
Authorization: Bearer {{reporterToken}}

{
  "photo": { "content": "{{jpegBase64}}", "thumbnail": "{{jpegBase64}}" }
}

### Apaga a descrição
# Resposta: 200, com "description": null.
PATCH {{baseUrl}}/reports/{{reportId}}
Content-Type: application/json
Authorization: Bearer {{reporterToken}}

{
  "description": ""
}

### Exclui o reporte: só o autor, com o reporte em validação
# Exclusão lógica: o reporte some de todas as rotas e continua contando no limite por dia.
# Resposta: 204. Fora de validação: 422.
DELETE {{baseUrl}}/reports/{{reportId}}
Authorization: Bearer {{reporterToken}}

### Depois da exclusão, o reporte não aparece mais
# Resposta: 404.
GET {{baseUrl}}/reports/{{reportId}}
Authorization: Bearer {{reporterToken}}
